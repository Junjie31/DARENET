# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Checkpoints and model files
*.pth
*.ckpt
*.pt
*.pth.tar

# Data files (keep code, exclude data)
*.mat
*.npz
*.hdf5
*.h5
data/
datasets/
PreprocessedData/

# Pretrained checkpoints: ignore everything except the two released ones.
pretrained/PreTrainedModels/*
!pretrained/PreTrainedModels/PURE_MMPD_DareNet_gated_tf_seed42_Epoch29.pth
!pretrained/PreTrainedModels/UBFC_MMPD_DareNet_gated_tf_seed42_Epoch29.pth
!pretrained/PreTrainedModels/CHECKSUMS.txt

# Logs and runs
*.log
logs/
runs/
experiment_logs/

# Output directories
outputs/
outputs_*/
saved_metrics/
dumps/
dumps_*/

# Results
*.xlsx
*.csv
!dataset/BP4D_BigSmall_Subject_Splits/*.csv

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Environment
.env
.venv
env/
venv/
.conda/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Build
build/
dist/
*.egg-info/

# Temporary
temp/
tmp/
*.tmp
